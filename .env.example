# Porta do servidor HTTP
PORT=8080

# Chave de API do TMDB (v3 ou v4 Token)
TMDB_API_KEY=sua_chave_ou_token_aqui

# Base URL da API do TMDB
TMDB_BASE_URL=https://api.themoviedb.org/3

# Tempo de expiração do cache in-memory em minutos
CACHE_TTL_MINUTES=60
CACHE_CLEANUP_MINUTES=10

# Base URL para o player de streaming Superflix
SUPERFLIX_BASE_URL=https://superflixapi.quest

# Modo do Gin (release ou debug)
GIN_MODE=release
